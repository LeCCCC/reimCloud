                {"key": "billStatus", "value": "0"},
                {"key": "reimCompanyId", "value": "1C61686865DA8000"}
              ]
            }
          },
          "description": "综合：单号模糊+草稿状态+武汉分公司"
        },
        {
          "name": "TC-11 空结果查询",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements?current=1&size=10&billNo=NOTEXIST",
              "host": ["{{baseUrl}}"],
