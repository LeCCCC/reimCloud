{
  "info": {
    "name": "差旅报销单系统 - 列表页面接口测试",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "1.1 报销单分页列表",
      "item": [
        {
          "name": "TC-01 默认分页（无筛选条件）",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements?current=1&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["travel-reimbursements"],
              "query": [
                {"key": "current", "value": "1"},
                {"key": "size", "value": "10"}
              ]
            }
          },
          "expected": {
            "description": "code=0, data.total=1, data.records[0].billNo=REIM20250522001"
          }
        },
        {
          "name": "TC-02 按报销单号模糊查询",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements?current=1&size=10&billNo=REIM",
              "host": ["{{baseUrl}}"],
              "path": ["travel-reimbursements"],
              "query": [
                {"key": "current", "value": "1"},
                {"key": "size", "value": "10"},
                {"key": "billNo", "value": "REIM"}
              ]
            }
          }
        },
