    {
      "name": "1. 报销单据页面主流程",
      "item": [
        {
          "name": "TC-07 新增报销单草稿",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reimbursementTitle\": \"北京出差报销\",\n  \"businessTripReason\": \"项目现场支持\",\n  \"reimburserId\": \"13AB3A3F72409002\",\n  \"reimburserNo\": \"74541\",\n  \"reimburserName\": \"徐年年\",\n  \"reimDepartmentId\": \"13AB8D7B52A9B002\",\n  \"reimDepartmentNo\": \"072001\",\n  \"reimDepartmentName\": \"客户成功事业部\",\n  \"reimCompanyId\": \"1C54557F1782E000\",\n  \"reimCompanyNo\": \"0407\",\n  \"reimCompanyName\": \"胜意科技北京分公司\",\n  \"businessTypeId\": \"1B5FEB7DD4396000\",\n  \"businessTypeNo\": \"10010010101\",\n  \"businessTypeName\": \"项目出差\",\n  \"tripList\": [\n    {\n      \"travelerId\": \"13AB3A3F72409002\",\n      \"travelerNo\": \"74541\",\n      \"travelerName\": \"徐年年\",\n      \"departureCityNo\": \"10458\",\n      \"departureCityName\": \"武汉\",\n      \"arrivalCityNo\": \"10119\",\n      \"arrivalCityName\": \"北京\",\n      \"departureDate\": \"2026-05-20\",\n      \"arrivalDate\": \"2026-05-21\",\n      \"tripDescription\": \"武汉到北京项目支持\"\n    }\n  ],\n  \"remarks\": \"Postman 新增草稿测试\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "travel-reimbursements"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('新增成功', function () {",
                  "  pm.expect(json.code).to.eql('0');",
                  "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.billStatus).to.eql('0');",
                  "});",
                  "pm.collectionVariables.set('reimbursementId', json.data.id);"
                ]
              }
            }
          ],
          "description": "预期：code=0，返回 id、billNo、billStatus=0，并自动写入 collection 变量 reimbursementId。"
        },
        {
          "name": "TC-08 查询新增后的报销单详情",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements/{{reimbursementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "travel-reimbursements",
                "{{reimbursementId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('详情查询成功', function () {",
                  "  pm.expect(json.code).to.eql('0');",
                  "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('reimbursementId'));",
                  "  pm.expect(json.data.tripList.length).to.be.above(0);",
                  "  pm.expect(json.data.subsidyList.length).to.be.above(0);",
                  "  pm.expect(json.data.costSummary.subsidyTotal).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('subsidyId', json.data.subsidyList[0].subsidyId);"
                ]
              }
            }
          ],
          "description": "预期：回显基础信息、补录行程、补助信息、费用合计，并自动保存 subsidyId。"
        },
        {
          "name": "TC-09 查询补助日历",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-reimbursements/{{reimbursementId}}/subsidies/{{subsidyId}}/calendar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "travel-reimbursements",
                "{{reimbursementId}}",
                "subsidies",
                "{{subsidyId}}",
                "calendar"
              ]
            }
