    .detail-table th, .summary-table th {
      background: #dfe8f7;
      text-align: center;
      font-weight: 700;
    }
    .pass {
      color: #0b7a28;
      font-weight: 700;
    }
    .risk {
      color: #b85a00;
      font-weight: 700;
    }
    ul {
      margin: 6px 0 6px 22px;
    }
    li {
      margin: 4px 0;
    }
    .note {
      color: #555;
      font-size: 10.5pt;
    }
