<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.reimcloud.mapper.EmployeeMapper">

    <select id="selectByKeyword" resultType="org.example.reimcloud.entity.Employee">
        SELECT * FROM employee
        <where>
            <if test="keyword != null and keyword != ''">
                employee_no LIKE CONCAT('%', #{keyword}, '%')
                OR employee_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY employee_no
    </select>

</mapper>
