<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.reimcloud.mapper.ReimDepartmentMapper">

    <select id="selectByKeyword" resultType="org.example.reimcloud.entity.ReimDepartment">
        SELECT * FROM reim_department
        <where>
            <if test="keyword != null and keyword != ''">
                department_no LIKE CONCAT('%', #{keyword}, '%')
                OR department_name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY department_no
    </select>

</mapper>
